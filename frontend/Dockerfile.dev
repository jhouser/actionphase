# Development image: runs the Vite dev server with HMR.
# Unlike the production Dockerfile (build -> static dist -> nginx), source is
# bind-mounted at runtime and Vite serves + hot-reloads it live.
FROM node:24-alpine

WORKDIR /app

# Install deps in the image so a fresh container is runnable before the source
# bind-mount lands, and so node_modules stays Linux-native regardless of host.
#
# node_modules is a named volume at runtime (see compose). Docker seeds that volume
# from this layer ONLY while the volume is empty — once populated it shadows the
# image copy permanently. So changing package.json and rebuilding is NOT enough:
# the stale volume must be dropped too. `just rebuild frontend` does that for you.
COPY package*.json ./
RUN npm ci

# 5173: Vite dev server.
EXPOSE 5173

# --host binds 0.0.0.0 so the port is reachable from outside the container.
CMD ["npm", "run", "dev", "--", "--host"]
